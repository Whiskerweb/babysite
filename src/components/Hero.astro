---
import Usdc from './Usdc.astro';
import { GAME_URL, PLAY_LABEL, CHAIN, CLAIM_CATEGORY } from '../data/site';
---
<section class="hero" id="top">
  <div class="hero__scrim"></div>

  <div class="hero__content">
    <!-- The claim goes ABOVE the headline and not inside it: "Bet. Run. Cash
         out." is what the game does to you, the badge is what the game IS.
         Merging them would cost the three-verb line, which is the strongest
         thing on the page. -->
    <p class="hero__claim">
      <span class="hero__claim-dot" aria-hidden="true"></span>
      <!-- Le libelle tient dans UN span. Laisses nus, les bouts de texte
           deviennent des elements flex separes : sur un telephone ils se
           rangeaient en colonnes et coupaient « run-to- / earn » en deux. -->
      <span class="hero__claim-txt">The first <strong>{CLAIM_CATEGORY}</strong> game on {CHAIN}</span>
    </p>

    <h1 class="hero__title">Bet. Run. Cash out.</h1>

    <p class="hero__sub">
      Battle royale for <Usdc /> stakes, on-chain results.
      1v1, squads of four, arenas of sixteen — playable right now, in the browser.
    </p>

    <a class="btn btn--gold btn--lg" href={GAME_URL}>{PLAY_LABEL}</a>

    <a class="link-quiet hero__trailer" href="#trailer">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
      Watch the trailer · 27s
    </a>
  </div>
</section>

<style>
  .hero{
    position: relative;
    min-height: min(96vh, 940px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: url('/img/hero-bg.jpg') center 30% / cover no-repeat, var(--violet-900);
    padding: clamp(90px, 16vh, 170px) 20px clamp(60px, 8vh, 96px);
    overflow: hidden;
  }
  .hero__scrim{
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(38,26,88,.38) 0%, rgba(38,26,88,0) 18%),
      linear-gradient(0deg,
        var(--violet-900) 0%,
        rgba(52,38,111,.94) 16%,
        rgba(52,38,111,.7) 30%,
        rgba(52,38,111,.26) 44%,
        rgba(52,38,111,0) 58%);
  }
  .hero__content{
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(14px, 2.2vh, 24px);
  }
  /* The badge. Gold hairline on a dark wash, because it sits on a photograph
     and a translucent pill alone would read differently over every part of it.
     Not a button: nothing here is clickable, gold stays the action colour. */
  .hero__claim{
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px;
    border: 1px solid rgba(255,201,60,.55);
    border-radius: 999px;
    background: rgba(26,14,58,.55);
    backdrop-filter: blur(6px);
    font-size: clamp(11.5px, 1.2vw, 14px);
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
    color: rgba(255,255,255,.92);
    text-shadow: 0 1px 6px rgba(0,0,0,.5);
  }
  .hero__claim-txt{ text-wrap: balance; }
  /* Le nom de la categorie ne se coupe jamais sur son trait d'union. */
  .hero__claim strong{ color: var(--gold); font-weight: 900; white-space: nowrap; }
  .hero__claim-dot{
    flex: none;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(255,201,60,.22);
  }

  .hero__title{
    font-size: clamp(27px, 4.9vw, 62px);
    text-transform: uppercase;
    letter-spacing: -1.2px;
    white-space: nowrap;
    text-shadow: 0 6px 24px rgba(0,0,0,.65), 0 2px 4px rgba(0,0,0,.5);
  }
  .hero__sub{
    max-width: 46ch;
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 600;
    line-height: 1.5;
    color: rgba(255,255,255,.88);
    text-shadow: 0 2px 12px rgba(0,0,0,.7);
  }
  .hero__trailer{ text-shadow: 0 2px 10px rgba(0,0,0,.7); }

  @media (max-width: 560px){
    .hero__claim{ padding: 8px 14px; gap: 7px; letter-spacing: .2px; line-height: 1.45; }
  }
</style>
