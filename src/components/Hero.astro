---
import Usdc from './Usdc.astro';
import { WHITELIST_PLACES } from '../data/site';
---
<section class="hero" id="top">
  <div class="hero__scrim"></div>

  <div class="hero__content">
    <h1 class="hero__title">Bet. Run. Cash out.</h1>

    <p class="hero__sub">
      16-player battle royale, real <Usdc /> stakes, on-chain results.
      The whitelist is open: {WHITELIST_PLACES} spots.
    </p>

    <a class="btn btn--gold btn--lg" href="#whitelist">Join the whitelist</a>

    <a class="link-quiet hero__trailer" href="#trailer">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
      Watch the trailer · 27s
    </a>
  </div>
</section>

<style>
  .hero{
    position: relative;
    min-height: min(96vh, 940px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: url('/img/hero-bg.jpg') center 30% / cover no-repeat, var(--violet-900);
    padding: clamp(90px, 16vh, 170px) 20px clamp(60px, 8vh, 96px);
    overflow: hidden;
  }
  .hero__scrim{
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(38,26,88,.38) 0%, rgba(38,26,88,0) 18%),
      linear-gradient(0deg,
        var(--violet-900) 0%,
        rgba(52,38,111,.94) 16%,
        rgba(52,38,111,.7) 30%,
        rgba(52,38,111,.26) 44%,
        rgba(52,38,111,0) 58%);
  }
  .hero__content{
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(14px, 2.2vh, 24px);
  }
  .hero__title{
    font-size: clamp(27px, 4.9vw, 62px);
    text-transform: uppercase;
    letter-spacing: -1.2px;
    white-space: nowrap;
    text-shadow: 0 6px 24px rgba(0,0,0,.65), 0 2px 4px rgba(0,0,0,.5);
  }
  .hero__sub{
    max-width: 46ch;
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 600;
    line-height: 1.5;
    color: rgba(255,255,255,.88);
    text-shadow: 0 2px 12px rgba(0,0,0,.7);
  }
  .hero__trailer{ text-shadow: 0 2px 10px rgba(0,0,0,.7); }
</style>
