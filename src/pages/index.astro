---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trailer from '../components/Trailer.astro';
import HowToPlay from '../components/HowToPlay.astro';
import PlayBar from '../components/PlayBar.astro';
import Token from '../components/Token.astro';
import Play from '../components/Play.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Baby Guy — Bet. Run. Cash out."
  description="Battle royale for USDC stakes, on-chain results. Three formats playable now in the browser: 1v1, squads of four and 16-player arenas, on 2, 5 and 10 USDC tables."
>
  <Header />
  <main>
    <Hero />          {/* 1 */}
    <Trailer />       {/* 2 */}
    <HowToPlay />     {/* 3 */}
      <PlayBar />       {/* 4 */}
    <Token />         {/* 5 */}
    <Play />          {/* 6 */}
    <Faq />
  </main>
  <Footer />
</Layout>
